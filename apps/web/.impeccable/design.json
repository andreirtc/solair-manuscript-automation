  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Implemented action variant with keyboard and disabled states.",
      "html": "<button class=\"ds-button-primary\">Validate & preview</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:44px;padding:10px 18px;border:0;border-radius:10px;font-family:\"Work Sans\",sans-serif;font-weight:500;font-size:15px;line-height:1.45;cursor:pointer;transition:background .18s,color .18s,box-shadow .18s,transform .18s;background:var(--action,#efb142);color:var(--on-action,#30220c);} .ds-button-primary:hover:not(:disabled){background:color-mix(in srgb,var(--action,#efb142) 84%,white);transform:translateY(-1px);} .ds-button-primary:focus-visible{outline:3px solid var(--brand,#1959b5);outline-offset:4px;} .ds-button-primary:disabled{opacity:.5;cursor:not-allowed;} @media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none;}}"
    },
    {
      "name": "Subtle Button",
      "kind": "button",
      "refersTo": "button-subtle",
      "description": "Implemented action variant with keyboard and disabled states.",
      "html": "<button class=\"ds-button-subtle\">Read proposal</button>",
      "css": ".ds-button-subtle{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:44px;padding:10px 18px;border:0;border-radius:10px;font-family:\"Work Sans\",sans-serif;font-weight:500;font-size:15px;line-height:1.45;cursor:pointer;transition:background .18s,color .18s,box-shadow .18s,transform .18s;background:var(--subtle,#f3f4f2);color:var(--ink,#202b3a);} .ds-button-subtle:hover:not(:disabled){background:var(--soft,#eaf0fb);color:var(--brand,#1959b5);} .ds-button-subtle:focus-visible{outline:3px solid var(--brand,#1959b5);outline-offset:4px;} .ds-button-subtle:disabled{opacity:.5;cursor:not-allowed;} @media(prefers-reduced-motion:reduce){.ds-button-subtle{transition:none;}}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Implemented action variant with keyboard and disabled states.",
      "html": "<button class=\"ds-button-danger\">Reject proposal</button>",
      "css": ".ds-button-danger{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:44px;padding:10px 18px;border:0;border-radius:10px;font-family:\"Work Sans\",sans-serif;font-weight:500;font-size:15px;line-height:1.45;cursor:pointer;transition:background .18s,color .18s,box-shadow .18s,transform .18s;background:var(--error-bg,#fff0ee);color:var(--error,#a02f32);} .ds-button-danger:hover:not(:disabled){} .ds-button-danger:focus-visible{outline:3px solid var(--brand,#1959b5);outline-offset:4px;} .ds-button-danger:disabled{opacity:.5;cursor:not-allowed;} @media(prefers-reduced-motion:reduce){.ds-button-danger{transition:none;}}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Above-label workspace field.",
      "html": "<label class=\"ds-field\">Workspace username<input placeholder=\"Your username\" /></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:9px;font:500 .88rem \"Work Sans\",sans-serif;color:var(--ink,#202b3a)}.ds-field input{font:400 15px/1.5 \"Work Sans\",sans-serif;padding:12px 13px;min-height:46px;background:var(--ground,#fffdf8);color:var(--ink,#202b3a);border:1px solid var(--line,#dce0e4);border-radius:8px}.ds-field input::placeholder{color:var(--muted,#626d79);opacity:1}.ds-field input:focus-visible{outline:3px solid var(--brand,#1959b5);outline-offset:4px;}"
    },
    {
      "name": "Workspace Navigation",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "Quiet sidebar rows with solar active state.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Workspace\"><button>Chat</button><button aria-current=\"page\">Review changes</button><button>History</button></nav>",
      "css": ".ds-nav{width:230px;font-family:\"Work Sans\",sans-serif}.ds-nav button{display:flex;width:100%;text-align:left;min-height:46px;padding:12px 14px;border:0;border-radius:9px;background:none;color:var(--ink,#202b3a);font:400 .88rem \"Work Sans\",sans-serif;margin-bottom:4px;cursor:pointer;transition:background .18s,color .18s}.ds-nav button:hover{background:var(--subtle,#f3f4f2)}.ds-nav button[aria-current]{background:var(--sun-soft,#fff2d8);color:var(--solar-ink,#945305);font-weight:500}.ds-nav button:focus-visible{outline:3px solid var(--brand,#1959b5);outline-offset:4px;}"
    },
    {
      "name": "Status Badge",
      "kind": "chip",
      "refersTo": "badge",
      "description": "Text state with neutral, completion and failure tones.",
      "html": "<div class=\"ds-badges\"><span>draft</span><span class=\"ds-success\">connected</span><span class=\"ds-error\">blocked</span></div>",
      "css": ".ds-badges{display:flex;gap:8px;font-family:\"Work Sans\",sans-serif}.ds-badges span{display:inline-flex;padding:4px 8px;border-radius:5px;font-size:.69rem;font-weight:500;line-height:1.5;background:var(--subtle,#f3f4f2);color:var(--muted,#626d79)}.ds-badges .ds-success{background:color-mix(in srgb,var(--success,#267153) 12%,var(--surface,#fff));color:var(--success,#267153)}.ds-badges .ds-error{background:var(--error-bg,#fff0ee);color:var(--error,#a02f32)}"
    },
    {
      "name": "Illustrative Manuscript Paper",
      "kind": "card",
      "refersTo": "illustrative-paper",
      "description": "Semantic public workflow example; never a live manuscript receipt.",
      "html": "<figure class=\"ds-paper\"><header>Illustrative workflow</header><div><h2>A revision you can see.</h2><p>Read the wording. Understand the reason.</p><section><strong>Before</strong><del>The prototype is complete.</del></section><section class=\"ds-paper-proposed\"><strong>Proposed</strong><p>The prototype is under development. Design decisions remain open.</p></section></div><figcaption>Example only \u00b7 no manuscript update</figcaption></figure>",
      "css": ".ds-paper{margin:0;max-width:620px;border-radius:16px;background:var(--surface,#fff);color:var(--ink,#202b3a);box-shadow:0 28px 60px -30px #162d5259;font:15px \"Work Sans\",sans-serif}.ds-paper header,.ds-paper figcaption{padding:14px 26px;font-size:.75rem;color:#596777}.ds-paper header{border-bottom:1px solid #9daab52a}.ds-paper figcaption{border-top:1px solid #9daab52a}.ds-paper>div{padding:26px 34px}.ds-paper h2{font:500 2rem/1.15 \"Outfit\",sans-serif;margin:0 0 13px}.ds-paper section{display:grid;grid-template-columns:75px 1fr;gap:18px;padding:13px 18px;border-radius:10px;background:#b3474510;color:#8d4241;margin-top:8px;line-height:1.65}.ds-paper section strong{font-size:.76rem;font-weight:500}.ds-paper section p{margin:0}.ds-paper .ds-paper-proposed{color:#245843;background:#3e8a5e15}"
    },
    {
      "name": "Chat Composer",
      "kind": "custom",
      "refersTo": "composer",
      "description": "Quiet writing panel with one solar send action; text guidance remains writable while working and delivery status is explicit. Phone running-state shortcut focuses this real composer.",
      "html": "<div class=\"ds-composer\"><textarea aria-label=\"Manuscript instruction\" placeholder=\"Tell SolAir what you\u2019d like to revise\u2026\"></textarea><div class=\"ds-compose-actions\"><span>Let the agent find it</span><button aria-label=\"Send instruction\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 3l19 9-19 9 4-9zM7 12h15\"/></svg></button></div></div>",
      "css": ".ds-composer{border:1px solid var(--line,#dce0e4);background:var(--surface,#fff);color:var(--ink,#202b3a);border-radius:16px;padding:18px 18px 12px;box-shadow:0 8px 26px -17px #172b4d50;font-family:\"Work Sans\",sans-serif}.ds-composer:focus-within{border-color:var(--brand,#1959b5)}.ds-composer textarea{display:block;width:100%;min-height:62px;border:0;background:none;color:inherit;font:400 .94rem/1.5 \"Work Sans\",sans-serif;resize:vertical;outline:none}.ds-composer textarea::placeholder{color:var(--muted,#626d79)}.ds-compose-actions{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-top:12px}.ds-compose-actions span{font-size:.78rem;background:var(--subtle,#f3f4f2);padding:8px 10px;border-radius:7px}.ds-compose-actions button{width:42px;height:42px;display:flex;align-items:center;justify-content:center;border:0;border-radius:10px;cursor:pointer;background:var(--action,#efb142);color:var(--on-action,#30220c);transition:background .18s}.ds-compose-actions button:hover{background:color-mix(in srgb,var(--action,#efb142) 84%,white)}.ds-compose-actions button:focus-visible{outline:3px solid var(--brand,#1959b5);outline-offset:4px;}"
    },
    {
      "name": "Inline Manuscript Proposal",
      "kind": "custom",
      "refersTo": "comparison-before",
      "description": "Stacked exact wording, reason/source evidence and one deliberate batch approval action in chat. This specimen illustrates UI only; it performs no write.",
      "html": "<section class=\"ds-inline-proposal\" aria-label=\"Proposed manuscript update\"><h3>Review this update</h3><div class=\"ds-comparison\"><section><h4>Before</h4><p>The process is done.</p></section><section><h4>Proposed</h4><p>The team records the measurements for analysis.</p></section></div><p class=\"ds-evidence\"><b>Reason &amp; sources</b>Clarifies the requested wording; read the cited source limitations.</p><p>Approving confirms you have read this batch, including removals and source limitations.</p><button class=\"ds-batch\">Approve and apply this batch</button></section>",
      "css": ".ds-inline-proposal{margin-top:28px;padding-top:22px;border-top:1px solid var(--line,#dce0e4);color:var(--ink,#202b3a);font:400 15px/1.7 \"Work Sans\",sans-serif;min-width:0}.ds-inline-proposal>h3{margin:0 0 12px;font:500 1.18rem \"Outfit\",sans-serif}.ds-comparison{display:grid;grid-template-columns:1fr;gap:12px}.ds-comparison section{padding:17px;border-radius:10px;background:var(--subtle,#f3f4f2);min-width:0}.ds-comparison section+section{background:var(--soft,#eaf0fb)}.ds-comparison h4{font-size:.7rem;font-weight:500;color:var(--muted,#626d79);margin:0 0 12px}.ds-comparison section+section h4{color:var(--brand,#1959b5)}.ds-comparison p{font-size:.85rem;line-height:1.8;white-space:pre-wrap;overflow-wrap:anywhere;margin:0}.ds-evidence{font-size:.8rem;color:var(--muted,#626d79);line-height:1.75;margin:20px 0 8px}.ds-evidence b{display:block;color:var(--ink,#202b3a);font-weight:500;margin-bottom:5px}.ds-batch{min-height:44px;max-width:100%;white-space:normal;border:0;border-radius:10px;padding:10px 18px;background:var(--action,#efb142);color:var(--on-action,#30220c);font:500 .88rem \"Work Sans\",sans-serif;cursor:pointer;transition:background .18s,transform .18s}.ds-batch:hover{background:color-mix(in srgb,var(--action,#efb142) 84%,white);transform:translateY(-1px)}.ds-batch:focus-visible{outline:3px solid var(--brand,#1959b5);outline-offset:4px}.ds-batch:active{transform:translateY(1px)}.ds-batch:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Conversation Purpose Choice",
      "kind": "button",
      "refersTo": "role-choice",
      "description": "Native aria-pressed button group; palette identifies purpose without implying verification. Artwork omitted from this self-contained specimen.",
      "html": "<div class=\"ds-purpose\" role=\"group\" aria-label=\"Choose your conversation space\"><button aria-pressed=\"true\">Manuscript editor</button><button class=\"ds-defense\" aria-pressed=\"false\">Defense coach</button><button class=\"ds-questions\" aria-pressed=\"false\">Questions</button><button class=\"ds-prototype\" aria-pressed=\"false\">Prototype planner</button></div>",
      "css": ".ds-purpose{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;font:.95rem \"Work Sans\",sans-serif}.ds-purpose button{min-height:68px;padding:10px 16px;border:0;border-radius:10px;text-align:left;background:transparent;color:var(--muted,#626d79);cursor:pointer}.ds-purpose button:hover{background:var(--subtle,#f3f4f2);color:var(--ink,#202b3a)}.ds-purpose button[aria-pressed=\"true\"]{background:var(--role-soft,#fff0cf);color:var(--role-color,#945305)}.ds-purpose button:focus-visible{outline:3px solid var(--brand,#1959b5);outline-offset:4px}.ds-purpose button:active{transform:translateY(1px)}.ds-purpose .ds-defense[aria-pressed=\"true\"]{background:#efe6fb;color:#7250a6}.ds-purpose .ds-questions[aria-pressed=\"true\"]{background:#fbe5f1;color:#a83d75}.ds-purpose .ds-prototype[aria-pressed=\"true\"]{background:#eaf0fb;color:#1959b5}"
    }
